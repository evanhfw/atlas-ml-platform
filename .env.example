# Application
APP_NAME="Atlas ML Platform"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
DOCS_ENABLED=true
DATABASE_ECHO=false

# PostgreSQL container initialization
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atlas_dev

# Application -> PostgreSQL (host)
DATABASE_URL=postgresql+asyncpg://atlas:CHANGE_ME@localhost:5432/atlas_dev

# API authentication. Local development defaults to disabled; production
# startup refuses to run unless this is true and both keys are >=32 chars.
# Generate with: openssl rand -hex 32
AUTH_ENABLED=false
API_KEY_READ=
API_KEY_WRITE=

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# S3-compatible object storage (SeaweedFS locally)
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=atlas
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=atlas-models
S3_REGION=us-east-1
S3_SECURE=false
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
S3_MAX_ATTEMPTS=3
ARTIFACT_MAX_SIZE_BYTES=104857600

# Reliability
READINESS_TIMEOUT_SECONDS=3
SHUTDOWN_GRACE_SECONDS=20

# Inference runtime
# "allowlist" (production-safe) or "auto" (local development only).
# auto trusts every uploaded artifact; production startup rejects it.
# The example uses auto so upload -> version -> activate -> predict works
# locally without editing checksums. Switch to allowlist for production.
ARTIFACT_TRUST_POLICY=auto
# Comma-separated SHA-256 checksums of joblib artifacts that may be deserialized.
# Empty means no artifact is trusted in allowlist mode. Never add a checksum for
# an untrusted upload.
TRUSTED_ARTIFACT_CHECKSUMS=
MODEL_CACHE_MAX_ENTRIES=8
MODEL_LOAD_TIMEOUT_SECONDS=10
INFERENCE_TIMEOUT_SECONDS=5
INFERENCE_MAX_BATCH_SIZE=256

# OpenTelemetry tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=atlas-ml-platform
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=1.0

# Local Grafana (change for any shared environment)
GRAFANA_ADMIN_PASSWORD=admin
